# Nusxa oling:  cp .env.example .env  va qiymatlarni to'ldiring.
# .env ni git ga QO'YMANG - u .gitignore da.

# CRM ga kirish
ADMIN_USER=admin
ADMIN_PASS=

# ESP32 shu token bilan murojaat qiladi.
# Proshivkadagi CARDS_TOKEN bilan bir xil bo'lishi shart.
# Yaratish:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# Sessiya cookie sini imzolash uchun. O'zgarsa hamma tizimdan chiqib ketadi.
# Yaratish:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Baza fayli va vaqt zonasi
DB_PATH=data/qulf.db
TZ_NAME=Asia/Tashkent
